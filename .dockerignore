# 版本控制
.git
.gitignore
.gitattributes

# 环境变量（禁止进入镜像）
.env
.env.*

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行时产物
celerybeat-schedule*
celerybeat.pid
*.log

# 部署与文档（不影响运行）
docker-compose.yml
update.sh
README.md
LICENSE
Dockerfile
.dockerignore
