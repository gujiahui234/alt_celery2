# =========================================================================
# alt_celery2 环境变量配置
# 复制本文件为 .env 并按实际环境修改：cp .env.example .env
# .env 文件已被 .gitignore / .dockerignore 排除，切勿提交真实密码。
# =========================================================================

# --- Redis-Stack 连接（必填） ---
# 带密码的 URL 格式：redis://:<password>@<host>:<port>/<db>
# 注意：broker 与 backend 建议使用不同 db 编号
CELERY_BROKER_URL=redis://:your-password@redis-stack-host:6379/0
CELERY_RESULT_BACKEND=redis://:your-password@redis-stack-host:6379/1

# --- Celery 行为（可选，默认值见注释） ---
# Worker 并发进程数（默认 2）
CELERY_WORKER_CONCURRENCY=2
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
CELERY_LOG_LEVEL=INFO
# 定时任务时区（默认 Asia/Shanghai）
CELERY_TIMEZONE=Asia/Shanghai

# --- Flower 监控（可选） ---
# Flower Web 端口（默认 5555）
FLOWER_PORT=5555
# Flower 登录认证，格式 user:password（务必修改默认值！）
FLOWER_BASIC_AUTH=admin:admin
